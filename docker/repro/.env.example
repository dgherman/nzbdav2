# Copy to .env and edit. Every value here has a working default in docker-compose.yml.

# ── image under test ─────────────────────────────────────────────────────────
NZBDAV_IMAGE=local/nzbdav:3

# ── reported hardware: Intel N100 (4 cores), 16 GB shared with the rest of the box ──
NZBDAV_CPUS=4
NZBDAV_MEMORY=6g

# ── ports on your machine ────────────────────────────────────────────────────
WEB_PORT=3000       # UI
API_PORT=8080       # strm playback + API. This is the port players talk to.
JELLYFIN_PORT=8096

# ── strm URLs ────────────────────────────────────────────────────────────────
# Baked into every *.strm file at import time, so set it BEFORE provisioning.
# Containers on this network (Jellyfin, churn): http://nzbdav:8080
# VLC or a browser on your desktop:              http://<your-lan-ip>:8080
BASE_URL=http://nzbdav:8080

# ── provider ─────────────────────────────────────────────────────────────────
# mock = the synthetic provider container (no credentials, deterministic).
# real = your own provider; fill in the block below and add nzbs yourself.
PROVIDER_MODE=mock

USENET_HOST=mock-usenet
USENET_PORT=1119
USENET_SSL=false
USENET_USER=mock
USENET_PASS=mock
USENET_CONNECTIONS=25
CONNECTIONS_PER_STREAM=25

# For PROVIDER_MODE=real, e.g. Eweka:
# USENET_HOST=news.eweka.nl
# USENET_PORT=563
# USENET_SSL=true
# USENET_USER=your-user
# USENET_PASS=your-pass

# ── synthetic content ────────────────────────────────────────────────────────
MOCK_SIZE_MB=4096         # one file this big; large enough that seeks land far apart
MOCK_SEGMENT_KB=700
MOCK_LATENCY_MS=40        # per-article latency; raise to model a distant/slow provider
MOCK_JITTER_MS=10
MOCK_STALL_RATE=0.0       # 0.01 = 1% of article fetches stall, exercising the retry paths

# ── load generator ───────────────────────────────────────────────────────────
CHURN_MODE=seek           # seek | rapid-open | sequential
CHURN_ITERATIONS=25
CHURN_READ_BYTES=2097152
CHURN_GAP_SECONDS=1

# ── misc ─────────────────────────────────────────────────────────────────────
JELLYFIN_VERSION=10.11.11
LOG_LEVEL=Information     # Debug for stream-level detail
API_KEY=repro-api-key
